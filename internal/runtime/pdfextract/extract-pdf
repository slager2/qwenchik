#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
	exit 22
fi

input=/input/document.pdf
info=/tmp/pdfinfo.txt
info_error=/tmp/pdfinfo.stderr
text=/tmp/pdftotext.txt
text_error=/tmp/pdftotext.stderr

if ! pdfinfo "$input" >"$info" 2>"$info_error"; then
	exit 20
fi
if [ -s "$info_error" ]; then
	exit 21
fi

pages=$(awk '$1 == "Pages:" { print $2; count++ } END { if (count != 1) exit 1 }' "$info") || exit 22
encrypted=$(awk '$1 == "Encrypted:" { print $2; count++ } END { if (count != 1) exit 1 }' "$info") || exit 22
case "$pages" in
	''|*[!0-9]*) exit 22 ;;
esac
if [ "$encrypted" != "no" ]; then
	exit 23
fi
if [ "${#pages}" -gt 2 ]; then
	exit 24
fi
if [ "$pages" -lt 1 ]; then
	exit 22
fi
if [ "$pages" -gt 20 ]; then
	exit 24
fi

if ! pdftotext -enc UTF-8 -nopgbrk "$input" "$text" 2>"$text_error"; then
	exit 25
fi
if [ -s "$text_error" ]; then
	exit 26
fi

printf 'QAGENT_PDF_PAGES:%s\n' "$pages"
cat "$text"
