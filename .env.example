APP_BIND_ADDR=127.0.0.1:8080
DATABASE_PATH=./data/qagent.db
ARTIFACTS_PATH=./data/artifacts
WORKSPACE_ROOT=./data/workspaces

# Local llama.cpp OpenAI-compatible server; keep it on a different port from the app.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=local-qwen
# Match the actual llama-server context; keep one inference slot for the local model.
LLM_CONTEXT_LENGTH=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.8
LLM_ENABLE_THINKING=false
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=1

# Optional loopback SearXNG URL: http://127.0.0.1:8081
SEARXNG_URL=
# Enabled search providers send research queries externally; configured is not healthy.
SEARCH_ENABLE_DDG=true
TAVILY_API_KEY=

# Chat/research mode and research_settings.web_enabled belong to the conversation API, not env flags.
# Phase 1 uses the fixed-plan worker; profiles set ceilings, not promised work or duration.
RESEARCH_DEFAULT_PROFILE=standard
# Adaptive research is unavailable in Phase 1; true is a configuration error.
RESEARCH_ADAPTIVE_ENABLED=false

# Optional SearXNG container Compose setting; not read by qagent itself.
SEARXNG_SECRET=

SANDBOX_RUNTIME=auto
SANDBOX_IMAGE=golang:1.23-alpine
SANDBOX_NETWORK=disabled

# Preferred local immutable image ID or digest for isolated Poppler PDF extraction.
# Rootless Docker is required unless unsandboxed fallback is explicitly permitted.
PDF_EXTRACTOR_IMAGE=
MAX_SOURCE_BYTES=16777216
MAX_PDF_BYTES=67108864
PDF_MAX_PAGES=20
PDF_MAX_TEXT_RUNES=50000
PDF_EXTRACTION_TIMEOUT_SECONDS=30
PDF_DOWNLOAD_TIMEOUT_SECONDS=120
PDF_EXTRACTOR_MEMORY_MB=512
PDF_EXTRACTOR_TMP_MB=64
PDF_ALLOW_UNSANDBOXED_FALLBACK=false
ARTIFACT_MAX_BYTES=67108864
SANDBOX_MAX_FILE_BYTES=5000000
FETCH_TEMP_DIR=./data/fetch-temp
FETCH_TEMP_TASK_BYTES=134217728
FETCH_TEMP_GLOBAL_BYTES=268435456

MAX_STEPS=12
# Legacy task timeout, 1..21600 seconds; session-backed research uses its persisted profile deadline.
TASK_TIMEOUT_SECONDS=7200
# Trusted server cap: deep/long/overnight nominal query ceilings 16/32/48 are clamped to this value.
MAX_SEARCH_QUERIES=12
# Cumulative bytes actually read across all sources and attempts of a task.
MAX_FETCH_BYTES=134217728
ALLOWED_DOMAINS=
