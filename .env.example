APP_BIND_ADDR=127.0.0.1:8080
DATABASE_PATH=./data/qagent.db
ARTIFACTS_PATH=./data/artifacts
WORKSPACE_ROOT=./data/workspaces

# Local llama.cpp OpenAI-compatible server; keep it on a different port from the app.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=local-qwen
LLM_CONTEXT_LENGTH=131072
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.8
LLM_ENABLE_THINKING=false
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=1

SEARXNG_URL=
TAVILY_API_KEY=

# Optional SearXNG container Compose setting; not read by qagent itself.
SEARXNG_SECRET=

SANDBOX_RUNTIME=auto
SANDBOX_IMAGE=golang:1.23-alpine
SANDBOX_NETWORK=disabled

# Preferred local immutable image ID or digest for isolated Poppler PDF extraction.
# If unset or unavailable, a bounded pure-Go helper process is used instead.
PDF_EXTRACTOR_IMAGE=

MAX_STEPS=12
TASK_TIMEOUT_SECONDS=7200
MAX_SEARCH_QUERIES=12
MAX_FETCH_BYTES=5000000
ALLOWED_DOMAINS=
